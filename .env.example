APPLE_MUSIC_BEARER_TOKEN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional per-source outbound proxies. Source-specific values take precedence
# over TTML_PROXY_ALL and standard HTTPS_PROXY/HTTP_PROXY.
TTML_PROXY_ALL=
TTML_PROXY_APPLE_MUSIC=
TTML_PROXY_QQ_MUSIC=
TTML_PROXY_NCM_MUSIC=
TTML_PROXY_SPOTIFY=

# Global budget and per-source semaphores. Provider-local pools are disabled in v2.
TTML_SEARCH_WORKERS=3
TTML_SOURCE_APPLE_MUSIC_WORKERS=1
TTML_SOURCE_QQ_MUSIC_WORKERS=2
TTML_SOURCE_SPOTIFY_WORKERS=1
TTML_SOURCE_NCM_MUSIC_WORKERS=1
TTML_HTTP_TIMEOUT_SECONDS=20
TTML_HTTP_ATTEMPTS=3

# Backend storage. Use local for CLI/dev; use vercel for Vercel Blob + Redis/KV.
ID_MATCH_STORAGE_BACKEND=local
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
