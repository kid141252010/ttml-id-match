APPLE_MUSIC_BEARER_TOKEN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional per-source outbound proxies. Source-specific values take precedence
# over TTML_PROXY_ALL and standard HTTPS_PROXY/HTTP_PROXY.
TTML_PROXY_ALL=
TTML_PROXY_APPLE_MUSIC=
TTML_PROXY_QQ_MUSIC=
TTML_PROXY_NCM_MUSIC=
TTML_PROXY_SPOTIFY=

# Optional per-source internal request parallelism. Set any value to 1 when
# upstream services rate-limit or when you need serial request behavior.
TTML_APPLE_MUSIC_WORKERS=3
TTML_SPOTIFY_MARKET_WORKERS=2
TTML_NCM_QUERY_WORKERS=2

# Backend storage. Use local for CLI/dev; use vercel for Vercel Blob + Redis/KV.
ID_MATCH_STORAGE_BACKEND=local
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
